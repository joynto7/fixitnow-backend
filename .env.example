# Server
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:4000
# Where a customer's browser lands after a payment gateway redirect
FRONTEND_URL=http://localhost:3000

# Database (Postgres connection string). This matches `docker compose up -d`;
# point it at your own instance (local, or a free Neon/Supabase database) instead if you prefer.
DATABASE_URL="postgresql://fixitnow:fixitnow_dev_pw@localhost:5544/fixitnow?schema=public"

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Admin seed credentials (used by prisma/seed.ts)
ADMIN_EMAIL=admin@fixitnow.com
ADMIN_PASSWORD=Admin123!

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SSLCommerz
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false

# Cloudflare R2 (service work-photo/video uploads) - S3-compatible object storage
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Public base URL for the bucket (r2.dev subdomain, or a custom domain) - no trailing slash
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
