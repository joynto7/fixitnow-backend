# Server
PORT=4000
NODE_ENV=development
BASE_URL=http://localhost:4000
# Where a customer's browser lands after a payment gateway redirect
FRONTEND_URL=http://localhost:3000

# Database (Postgres connection string). This matches `docker compose up -d`;
# point it at your own instance (local, or a free Neon/Supabase database) instead if you prefer.
DATABASE_URL="postgresql://fixitnow:fixitnow_dev_pw@localhost:5544/fixitnow?schema=public"

# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Admin seed credentials (used by prisma/seed.ts)
ADMIN_EMAIL=admin@fixitnow.com
ADMIN_PASSWORD=Admin123!

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SSLCommerz
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false
